datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  shortDesc   String
  longDesc    String?
  durationMin Int
  price       Int
  imageUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminUser {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String
  role      String  @default("admin")
  createdAt DateTime @default(now())
}
