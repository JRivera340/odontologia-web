  "validation_guide": {
    "HU-05_revalidation": {
      "test_name": "Verify admin changes update public pages",
      "steps": [
        "1. Open two browser windows:",
        "   - Window A: http://localhost:3000/servicios (public)",
        "   - Window B: http://localhost:3000/admin (admin)",
        "2. Login to admin: admin@clinica.com / Admin123!",
        "3. Edit an existing service (change title, price, or description)",
        "4. Save the service",
        "5. Check server console for: 'Revalidated paths: [...]'",
        "6. Refresh Window A (public page)",
        "7. Verify changes are visible immediately"
      ],
      "expected_result": "Public page shows updated data after refresh",
      "note": "Revalidation is on-demand, not real-time WebSocket"
    },
    "HU-06_image_upload": {
      "test_name": "Verify image upload functionality",
      "steps": [
        "1. Go to http://localhost:3000/admin/login",
        "2. Login: admin@clinica.com / Admin123!",
        "3. Click '+ Nuevo Servicio' or edit existing service",
        "4. Look for 'Imagen del servicio' field",
        "5. Click file input and select an image",
        "6. Verify preview appears immediately",
        "7. Save the service",
        "8. Check public page to see the image"
      ],
      "expected_result": "Image preview shows, service saves with Cloudinary URL",
      "note": "Requires Cloudinary credentials in .env.local",
      "without_credentials": "File input and preview still work, but upload will fail with error message"
    }
  },

